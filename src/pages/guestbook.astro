---
export const prerender = true;


import { getEntry, render } from "astro:content";

import Markdown from "@components/common/markdown.astro";
import Comment from "@components/comment.astro";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";


const guestbookPost = await getEntry("spec", "guestbook");
if (!guestbookPost) {
    throw new Error("Guestbook page content not found");
}
const pageTitle = guestbookPost.data.title || "留言板";
const pageDescription = guestbookPost.data.description || "";

const { Content, headings } = await render(guestbookPost);
---

<GridLayout title={pageTitle} description={pageDescription} headings={headings}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32 mb-4">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <BackwardButton currentPath={Astro.url.pathname} />
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
    <Comment path="/guestbook/" />
</GridLayout>
